{
  "name": "techtonics-ui",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve ui_workbench",
    "build": "ng build ui_workbench",
    "build:prod": "ng build -c production",
    "build:prod-stats": "ng build -c bundle-analysis",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:lib": "ng build techtonics-ui --configuration production",
    "watch:lib": "ng build techtonics-ui --watch",
    "clean:lib": "rimraf dist/ .angular/cache/ && echo 'Cache cleared!'",
    "rebuild:lib": "npm run clean:lib && npm run build:lib",
    "prepare": "husky",
    "gen-meta": "node scripts/bundle-meta.js"
  },
  "private": true,
  "packageManager": "npm@11.6.1",
  "dependencies": {
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/router": "22.2.6",
    "@ng-icons/core": "36.1.0",
    "@ng-icons/tabler-icons": "36.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@angular/language-service": "22.2.6",
    "@types/jsdom": "30.0.0",
    "husky": "9.1.7",
    "jsdom": "31.0.1",
    "ng-packagr": "22.2.6",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "msgpackr-extract@3.0.4": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "ttf2woff@3.0.0": true,
    "ttf2woff2@8.0.1": true,
    "@parcel/watcher@2.6.0": true
  }
}
